@startuml
' Рисунок 3.3 — Діаграма сценаріїв використання системи.
' Джерело: підрозділ 3.7 (UC-01…UC-10) і текст плейсхолдера рисунка 3.3. До 2026-11-12 зв'язки були
' UC-03 «include» UC-09 і UC-04 «extend» UC-03, а актор — «Планувальник (система)».
' 2026-11-12 (зовнішня рецензія UML): внутрішній «Планувальник (система)» не може бути актором —
' подію часу («блок минає без виконання») подає актор «Таймер»; UC-03 ініціює Користувач; UC-09 —
' умовне розширення («extend») UC-03 і UC-01 (лише за під'єднаного календаря), а не «include»;
' Google Calendar — зовнішня система (прямокутник «system»); назви без «петлі прощення» й «як навчання».
!pragma layout smetana
skinparam defaultFontSize 14
skinparam defaultFontName Arial
skinparam monochrome true
skinparam shadowing false
left to right direction

actor "Користувач" as U
actor "Таймер\n(подія часу)" as T
rectangle "«system»\nGoogle Calendar" as GC

rectangle "Hourwell" {
  usecase "UC-01. Перший запуск\nта онбординг" as UC1
  usecase "UC-02. Швидке\nзахоплення задачі" as UC2
  usecase "UC-03. Генерація\nденного плану" as UC3
  usecase "UC-04. Перепла-\nнування пропу-\nщеної задачі" as UC4
  usecase "UC-05. Конфлікт\nперевантаженого дня" as UC5
  usecase "UC-06. Фокус-сесія\nзі зворотним зв’язком" as UC6
  usecase "UC-07. Ручне коригування\nрозкладу" as UC7
  usecase "UC-08. Тижневий огляд" as UC8
  usecase "UC-09. Синхронізація\nіз зовнішнім\nкалендарем" as UC9
  usecase "UC-10. Реалізація\nправ на дані" as UC10
}

U -- UC1
U -- UC2
U -- UC3
U -- UC5
U -- UC6
U -- UC7
U -- UC8
U -- UC10
UC4 -- T
UC9 -- GC

' напрям запису — від бази до розширення, щоб розширення стали правою колонкою біля своїх акторів;
' стрілка однаково вказує на базовий сценарій («extend» → база)
UC3 <.. UC4 : <<extend>>
UC3 <.. UC9 : <<extend>>
UC1 <.. UC9 : <<extend>>
@enduml
