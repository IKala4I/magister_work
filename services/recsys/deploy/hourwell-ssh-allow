#!/usr/bin/env bash
# Host-side SSH allow-list for the ADR-0009 VM (docs/runbooks/oracle-vm.md §0 and §3).
#
# Source of truth = the instance's freeform tag `ssh-allow` (OCI Console → the instance → Tags),
# a comma/space-separated list of IPv4 addresses or CIDRs, or the word `any`. The systemd timer
# hourwell-ssh-allow.timer runs `sync` every minute: it reads the tag from the instance metadata
# service (IMDS v2, link-local, no credentials) and rewrites the HOURWELL-SSH iptables chain, so
# the host layer is managed from any browser exactly like the Security List — never from a shell
# you may no longer be able to open. Fail-safe: no tag / unreachable IMDS / nothing valid in the
# tag ⇒ the current list stays; the list is never emptied.
#
#   hourwell-ssh-allow sync                 # timer entry point (silent when nothing changes)
#   hourwell-ssh-allow apply <A> [<B> ...]  # set the list by hand (bootstrap / emergency); persists
#   hourwell-ssh-allow status               # tag vs applied vs live rules vs timer
#
# Every apply also regenerates /etc/iptables/rules.v4 from a template that holds ONLY host rules
# (Docker recreates its own chains at start — persisting them is a known reboot hazard).
set -euo pipefail
STATE_DIR=/etc/hourwell
STATE=$STATE_DIR/ssh-allow
RULES=/etc/iptables/rules.v4
CHAIN=HOURWELL-SSH
IMDS=http://169.254.169.254/opc/v2/instance/
TAG_KEY=ssh-allow

log() { echo "hourwell-ssh-allow: $*"; }
die() { log "$*" >&2; exit 1; }
[ "$(id -u)" = 0 ] || die "run as root (sudo)"

valid_cidr() {
  local ip="${1%/*}" pfx="${1#*/}" o
  [[ "$1" == */* ]] || pfx=32
  [[ "$pfx" =~ ^([0-9]|[12][0-9]|3[0-2])$ ]] || return 1
  [[ "$ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || return 1
  IFS=. read -r -a o <<<"$ip"; for x in "${o[@]}"; do [ "$x" -le 255 ] || return 1; done
}
normalize() { [[ "$1" == */* ]] && echo "$1" || echo "$1/32"; }

# parse a raw list (tag value or argv) → normalized, deduplicated CIDRs on stdout; "any" → 0.0.0.0/0
parse_list() {
  local raw="$*" item out=()
  raw="${raw//,/ }"; raw="${raw//;/ }"
  for item in $raw; do
    if [ "$item" = any ]; then echo "0.0.0.0/0"; return 0; fi
    if valid_cidr "$item"; then out+=("$(normalize "$item")"); else log "ignoring invalid entry '$item'" >&2; fi
  done
  printf '%s\n' "${out[@]:-}" | awk 'NF && !seen[$0]++'
}

read_tag() {
  curl -fsS --max-time 5 -H "Authorization: Bearer Oracle" "$IMDS" 2>/dev/null \
    | jq -r --arg k "$TAG_KEY" '.freeformTags[$k] // empty' 2>/dev/null || true
}

current_list() { [ -f "$STATE" ] && grep -v '^#' "$STATE" | awk 'NF' || true; }

live_rules() {
  iptables -S "$CHAIN" 2>/dev/null | awk '/^-A/ {for (i=1;i<=NF;i++) if ($i=="-s") print $(i+1)}' \
    | sed 's#^\([0-9.]*\)$#\1/32#'
}

apply_live() {  # $@ = normalized CIDRs
  iptables -N "$CHAIN" 2>/dev/null || true
  iptables -F "$CHAIN"
  local c; for c in "$@"; do iptables -A "$CHAIN" -s "$c" -j ACCEPT; done
  # the jump sits at the top of INPUT; anything not accepted in the chain falls through to REJECT
  iptables -C INPUT -p tcp -m tcp --dport 22 -m conntrack --ctstate NEW -j "$CHAIN" 2>/dev/null \
    || iptables -I INPUT 1 -p tcp -m tcp --dport 22 -m conntrack --ctstate NEW -j "$CHAIN"
  # remove legacy direct accepts for 22 (the OCI default and the first harden.sh version)
  while read -r rule; do
    [ -n "$rule" ] && eval "iptables -D INPUT ${rule#-A INPUT }"
  done < <(iptables -S INPUT | grep -E -- '--dport 22 ' | grep -v -- "-j $CHAIN")
}

persist() {  # regenerate rules.v4: host rules only, InstanceServices kept verbatim
  install -d -m 755 /etc/iptables
  {
    echo "# generated by hourwell-ssh-allow $(date -u +%FT%TZ) — do not edit; Docker adds its own chains at start"
    echo "*filter"
    echo ":INPUT ACCEPT [0:0]"; echo ":FORWARD DROP [0:0]"; echo ":OUTPUT ACCEPT [0:0]"
    echo ":$CHAIN - [0:0]"; echo ":InstanceServices - [0:0]"
    echo "-A INPUT -p tcp -m tcp --dport 22 -m conntrack --ctstate NEW -j $CHAIN"
    echo "-A INPUT -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT"
    echo "-A INPUT -p icmp -j ACCEPT"
    echo "-A INPUT -i lo -j ACCEPT"
    echo "-A INPUT -p tcp -m tcp --dport 80 -m conntrack --ctstate NEW -j ACCEPT"
    echo "-A INPUT -p tcp -m tcp --dport 443 -m conntrack --ctstate NEW -j ACCEPT"
    echo "-A INPUT -j REJECT --reject-with icmp-host-prohibited"
    echo "-A FORWARD -j REJECT --reject-with icmp-host-prohibited"
    echo "-A OUTPUT -d 169.254.0.0/16 -j InstanceServices"
    iptables -S "$CHAIN" | grep '^-A'
    iptables -S InstanceServices 2>/dev/null | grep '^-A' || true
    echo "COMMIT"
  } > "$RULES.tmp"
  iptables-restore --test < "$RULES.tmp" || die "generated $RULES failed iptables-restore --test; live rules untouched, file not written"
  install -m 640 "$RULES.tmp" "$RULES"; rm -f "$RULES.tmp"
}

apply_list() {  # $1 = source label, rest = CIDRs
  local src="$1"; shift
  [ $# -gt 0 ] || die "refusing to apply an empty list"
  install -d -m 755 "$STATE_DIR"
  apply_live "$@"
  { echo "# source=$src applied=$(date -u +%FT%TZ)"; printf '%s\n' "$@"; } > "$STATE.tmp"
  install -m 644 "$STATE.tmp" "$STATE"; rm -f "$STATE.tmp"
  persist
  log "applied ($src): $*"
}

case "${1:-}" in
  sync)
    tag="$(read_tag)"
    [ -n "$tag" ] || exit 0                       # no tag (or IMDS down): keep what we have
    mapfile -t want < <(parse_list "$tag")
    [ ${#want[@]} -gt 0 ] && [ -n "${want[0]}" ] || { log "tag '$TAG_KEY' has no valid entry — keeping the current list" >&2; exit 0; }
    if [ "$(printf '%s\n' "${want[@]}")" = "$(current_list)" ] && [ "$(live_rules)" = "$(current_list)" ]; then exit 0; fi
    apply_list tag "${want[@]}" ;;
  apply)
    shift; mapfile -t want < <(parse_list "$@")
    [ ${#want[@]} -gt 0 ] && [ -n "${want[0]}" ] || die "usage: hourwell-ssh-allow apply <ip-or-cidr> [...]"
    if [ -n "${SSH_CLIENT:-}" ]; then
      me="${SSH_CLIENT%% *}/32"
      if ! printf '%s\n' "${want[@]}" | grep -qxF -e "$me" -e "0.0.0.0/0"; then
        log "WARNING: your current address $me is not in the list — the next SSH connection from here will be refused (this session stays open)." >&2
      fi
    fi
    apply_list manual "${want[@]}"
    if [ -n "$(read_tag)" ]; then log "NOTE: the instance tag '$TAG_KEY' is set — the timer will re-apply it within a minute unless you update the tag too."; fi ;;
  status)
    tag="$(read_tag)"; echo "tag  $TAG_KEY = ${tag:-<not set — host list comes from the last apply>}"
    echo "state ($STATE):"; sed 's/^/  /' "$STATE" 2>/dev/null || echo "  <none>"
    echo "live  $CHAIN:"; live_rules | sed 's/^/  /'
    echo "timer: $(systemctl is-active hourwell-ssh-allow.timer 2>/dev/null || echo not-installed)  last: $(journalctl -u hourwell-ssh-allow -n 1 -o cat --no-pager 2>/dev/null || true)" ;;
  *) echo "usage: hourwell-ssh-allow sync | apply <ip-or-cidr> [...] | status" >&2; exit 2 ;;
esac
