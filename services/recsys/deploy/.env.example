# Copy to /home/ubuntu/hourwell/.env on the VM and `chmod 600 .env`. Never commit a filled copy.
# Compose interpolates RECSYS_* ; the recsys container additionally receives every line (env_file).
RECSYS_HOST=hourwell-recsys.duckdns.org
RECSYS_IMAGE=ghcr.io/ikala4i/hourwell-recsys
RECSYS_TAG=latest
# Supabase → Connect → "Transaction pooler" tab (NOT "Direct connection": that host is IPv6-only and
# the VM has no IPv6). Port 6543, user postgres.<project-ref>; the pooler cluster is project-specific
# (this project: aws-1-eu-west-1 — aws-0 answers "tenant not found"). URL-encode the password.
# sslmode=require: never let the driver fall back to plaintext (Supabase docs).
DATABASE_URL=postgresql://postgres.uapiuehjcntilwdmpojk:<db-password>@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_URL=https://uapiuehjcntilwdmpojk.supabase.co
# 64-hex backend key shared with the edge functions (supabase secrets) and Vault (hourwell_service_key)
HOURWELL_SERVICE_KEY=<64 hex>
# --- P11 training container (ADR-0015) ---
TRAINING_IMAGE=ghcr.io/ikala4i/hourwell-training
TRAINING_TAG=latest
# secret API key (Dashboard -> Settings -> API keys -> "Secret keys" -> create/reveal,
# sb_secret_...): artifact uploads to the private EU `models` bucket; without it the
# nightly run completes but never promotes a model version. The legacy service_role JWT
# (the "Legacy" tab) also works — the code picks the right header per key kind — but
# prefer sb_secret_: revocable/rotatable without a JWT-secret rotation, and the legacy
# keys are on a deprecation path.
SUPABASE_SERVICE_ROLE_KEY=<sb_secret_... (or the legacy service_role JWT)>
# any long random string; hashes archive user ids (ADR-0015 §17). Never rotate mid-study.
ARCHIVE_SALT=<64 random hex>
