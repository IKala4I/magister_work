# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# build artifacts
/build
*.apk
*.aab
*.ipa

# supabase
supabase/.temp

# Python
.venv/
__pycache__/
*.pyc
.mypy_cache/
.ruff_cache/
.pytest_cache/

# thesis working files (never published from this repo)
docs/thesis/draft.docx
docs/thesis/*.docx
# private data and build outputs live outside the repo in MagisterDocs (owner, 2026-09-29): the
# draft, the names for the title page, 4.1's screenshots, the .docx/PDF and the golden. These lines
# stay as guards against an accidental copy back into the repo
docs/thesis/docx-pipeline/out/
docs/thesis/docx-pipeline/golden/
**/titulka.json
docs/thesis/figures/
docs/**/*.pdf
docs/**/*.docx
# the figure renderer's own Chrome (puppeteer cache) and PlantUML jar — downloaded, pinned, never committed
docs/thesis/docx-pipeline/render/.cache/
docs/thesis/docx-pipeline/render/.tools/

# local session exports (never commit conversation transcripts)
session-backup*.txt
*.build.log
coverage/

# python coverage
.coverage
coverage.xml
