{
  "imports": {
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2.112.4",
    "@std/assert": "jsr:@std/assert@1"
  },
  "tasks": {
    "test": "deno test --allow-read --allow-env",
    "check": "deno check _shared/*.ts plan-request/*.ts attribute-rewards/*.ts",
    "lint": "deno lint",
    "fmt": "deno fmt --check"
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.window"]
  },
  "fmt": {
    "lineWidth": 100,
    "singleQuote": true,
    "exclude": ["_shared/testdata/"]
  },
  "lint": {
    "rules": { "tags": ["recommended"] }
  }
}
